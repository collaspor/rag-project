 # =========================
  # Python
  # =========================
  __pycache__/
  *.py[cod]
  *$py.class
  *.so

  # Virtual environments
  .venv/
  venv/
  env/
  ENV/

  # Packaging
  build/
  dist/
  .eggs/
  *.egg-info/
  pip-wheel-metadata/

  # =========================
  # IDE / Editor
  # =========================
  .idea/
  .vscode/
  *.iml

  # =========================
  # Jupyter
  # =========================
  .ipynb_checkpoints/

  # =========================
  # OS files
  # =========================
  .DS_Store
  Thumbs.db
  desktop.ini

  # =========================
  # Logs
  # =========================
  logs/
  *.log
  controller.log
  controller.log.*
  openai_api.log
  openai_api_server.log
  model_worker_*.log

  # =========================
  # Runtime / cache
  # =========================
  .cache/
  tmp/
  temp/
  *.tmp

  hwrag/data/cache/
  hwrag/data/result/
  hwrag/data/result/**

  # =========================
  # Local datasets / private data
  # =========================
  data/
  knowledge_base/
  document_loaders/__pycache__/
  playground/

  # 如果你只想保留测试样例，可以注释掉上一条 data/，
  # 改为精细控制，例如：
  # data/*
  # !data/README.md

  # =========================
  # Vector index / embeddings / retrieval artifacts
  # =========================
  *.faiss
  *.index
  *.npy
  *.npz
  *.pt
  *.bin
  *.ckpt
  *.safetensors

  # 如果 knowledge_base 下有索引和私有文档，不建议上传
  knowledge_base/**

  # =========================
  # Model files
  # =========================
  *.gguf
  *.onnx
  *.engine
  *.pb
  *.tflite

  # =========================
  # Secrets / env
  # =========================
  .env
  .env.*
  *.env
  *.pem
  *.key
  *.crt
  *.p12
  *.pfx
  secrets.json
  secret.json

  # Common secret patterns stored as files
  config.local.yaml
  config.local.yml
  settings.local.yaml
  settings.local.yml

  # =========================
  # Test / coverage
  # =========================
  .coverage
  .coverage.*
  htmlcov/
  .pytest_cache/
  .mypy_cache/
  .ruff_cache/

  # =========================
  # Notebook / exported artifacts
  # =========================
  *.nbconvert.ipynb

  # =========================
  # Autogenerated / backup files
  # =========================
  *.bak
  *.swp
  *.swo
  *~